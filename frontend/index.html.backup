<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>KAARYA | Hardware Skills Development</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <h1>KAARYA</h1>

        <nav>
            <a href="#home">Home</a>
            <a href="#challenges">Challenges</a>
            <a href="#learning">Learning</a>
            <a href="#login">Login</a>
        </nav>
    </header>


    <main>

        <section id="home">
            <h2>Challenge Your Skills.</h2>

            <p>
                KAARYA is a hardware skills development platform
                designed for mechanical engineers.
            </p>

            <button onclick="testAPI()">
                Test Backend
            </button>

            <p id="apiStatus"></p>
        </section>


        <section id="challenges">
            <h2>Hardware Challenges</h2>

            <div id="challengeList">
                Loading challenges...
            </div>
        </section>


        <section id="learning">
            <h2>Learning Modules</h2>

            <div id="learningList">
                Loading learning modules...
            </div>
        </section>


        <section id="login">

            <h2>Candidate Login</h2>

            <form id="loginForm">

                <input
                    type="email"
                    id="email"
                    placeholder="Email"
                    required
                >

                <input
                    type="password"
                    id="password"
                    placeholder="Password"
                    required
                >

                <button type="submit">
                    Login
                </button>

            </form>

            <p id="loginStatus"></p>

        </section>

    </main>


    <script src="app.js"></script>

</body>
</html>
